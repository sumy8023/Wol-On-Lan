<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <AssemblyName>WOL-Proxy-Windows</AssemblyName>
    <RootNamespace>WolProxyLauncher</RootNamespace>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2</FileVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <PayloadPath Condition="'$(PayloadPath)' == ''">payload.zip</PayloadPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="wol-proxy-payload.zip" />
  </ItemGroup>
</Project>
